  <script>
    // =========================================================
    // ENDPOINTS TO CONNECT LATER
    // Use Cloudflare Worker URLs here when each backend is ready.
    // Leaving an endpoint blank keeps the page in local/demo mode.
    // =========================================================

    const REFLECTION_REQUEST_ENDPOINT = "";
    const REFLECTION_TAKEAWAYS_ENDPOINT = "";
    const OBSERVATION_REQUEST_ENDPOINT = "";
    const DEVELOPMENT_GOAL_ENDPOINT = "";
    const SUPPORT_REFLECTION_ENDPOINT = "";
    const RECORDING_REQUEST_ENDPOINT = "";
    const SELF_EVAL_ENDPOINT = "";
    const FINAL_OBSERVATION_REQUEST_ENDPOINT = "";

    const KEYS = {
      coachName: "raf_coach_name",
      readingComplete: "raf_reading_complete",
      currentSlide: "raf_current_slide",
      reflectionRequested: "raf_reflection_requested",
      reflectionTakeaways: "raf_reflection_takeaways",
      reflectionSubmitted: "raf_reflection_submitted",
      observationRequested: "raf_observation_requested",
      developmentGoal: "raf_development_goal",
      developmentGoalSubmitted: "raf_development_goal_submitted",
      supportReflection: "raf_support_reflection",
      supportSubmitted: "raf_support_submitted",
      recordingRequested: "raf_recording_requested",
      selfEval: "raf_self_eval",
      selfEvalSubmitted: "raf_self_eval_submitted",
      finalObservationRequested: "raf_final_observation_requested"
    };

    const $ = (id) => document.getElementById(id);

    function getBool(key) {
      return localStorage.getItem(key) === "true";
    }

    function setBool(key, value = true) {
      localStorage.setItem(key, value ? "true" : "false");
    }

    function saveJSON(key, value) {
      localStorage.setItem(key, JSON.stringify(value));
    }

    function loadJSON(key, fallback = null) {
      try {
        const raw = localStorage.getItem(key);
        return raw ? JSON.parse(raw) : fallback;
      } catch {
        return fallback;
      }
    }

    function coachName() {
      return localStorage.getItem(KEYS.coachName) || "";
    }

    function nowIso() {
      return new Date().toISOString();
    }

    async function postJSON(endpoint, payload) {
      if (!endpoint) {
        return { ok: true, demo: true };
      }

      const response = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      if (!response.ok) {
        throw new Error(`Request failed with status ${response.status}`);
      }

      let data = null;
      try { data = await response.json(); } catch { data = null; }
      return { ok: true, demo: false, data };
    }

    function showSuccess(container, message) {
      container.innerHTML = `<div class="success-message">${message}</div>`;
    }

    function showWarning(container, message) {
      container.innerHTML = `<div class="warning-message">${message}</div>`;
    }

    function demoSuffix(result) {
      return result.demo
        ? " <span class='inline-note'>(Local test mode — notification/data endpoint will be connected later.)</span>"
        : "";
    }

    // =========================================================
    // START / NAME
    // =========================================================

    function initializeStart() {
      const savedName = coachName();
      if (savedName) {
        $("coach-name").value = savedName;
        $("start-status").textContent = `Welcome back, ${savedName}. Your saved progress has been restored.`;
      }
    }

    $("confirm-start").addEventListener("click", () => {
      const name = $("coach-name").value.trim();
      if (!name || name.split(/\s+/).length < 2) {
        $("start-status").textContent = "Please enter your first and last name.";
        return;
      }
      localStorage.setItem(KEYS.coachName, name);
      $("start-status").textContent = `Thanks, ${name}. Step 1 is ready.`;
      updateUI();
      $("step-1").scrollIntoView({ behavior: "smooth" });
    });

    // =========================================================
    // READING SLIDES
    // =========================================================

    const slides = Array.from(document.querySelectorAll(".reading-slide"));
    let currentSlide = Number(localStorage.getItem(KEYS.currentSlide) || 0);
    if (!Number.isFinite(currentSlide) || currentSlide < 0 || currentSlide >= slides.length) currentSlide = 0;

    function showSlide(index) {
      currentSlide = Math.max(0, Math.min(index, slides.length - 1));
      localStorage.setItem(KEYS.currentSlide, String(currentSlide));

      slides.forEach((slide, i) => slide.classList.toggle("active", i === currentSlide));
      $("slide-counter").textContent = `${currentSlide + 1} of ${slides.length}`;
      $("reading-progress-bar").style.width = `${((currentSlide + 1) / slides.length) * 100}%`;
      $("prev-slide").disabled = currentSlide === 0;
      $("next-slide").classList.toggle("hidden", currentSlide === slides.length - 1);
      $("finish-reading").classList.toggle("hidden", currentSlide !== slides.length - 1 || getBool(KEYS.readingComplete));
    }

    $("prev-slide").addEventListener("click", () => showSlide(currentSlide - 1));
    $("next-slide").addEventListener("click", () => showSlide(currentSlide + 1));

    $("finish-reading").addEventListener("click", () => {
      setBool(KEYS.readingComplete);
      showSuccess($("reading-complete-message"), "Reading complete. Step 2 is now available.");
      $("reading-complete-message").classList.remove("hidden");
      updateUI();
      setTimeout(() => $("step-2").scrollIntoView({ behavior: "smooth" }), 250);
    });

    // =========================================================
    // STEP 2: REFLECTION MEETING
    // =========================================================

    $("request-reflection").addEventListener("click", async () => {
      const btn = $("request-reflection");
      btn.disabled = true;
      btn.textContent = "Sending Request...";

      try {
        const result = await postJSON(REFLECTION_REQUEST_ENDPOINT, {
          coach_name: coachName(),
          request_type: "reflection_meeting",
          requested_at: nowIso()
        });
        setBool(KEYS.reflectionRequested);
        showSuccess($("reflection-request-status"), `Reflection meeting request recorded.${demoSuffix(result)}`);
        $("reflection-takeaway-card").classList.remove("hidden");
        btn.textContent = "Reflection Meeting Requested";
        updateUI();
      } catch (error) {
        showWarning($("reflection-request-status"), "The request could not be sent. Please try again.");
        btn.disabled = false;
        btn.textContent = "Request Reflection Meeting";
      }
    });

    $("reflection-form").addEventListener("submit", async (event) => {
      event.preventDefault();
      const takeaways = $("reflection-takeaways").value.trim();
      if (!takeaways) return;

      const payload = {
        coach_name: coachName(),
        submitted_at: nowIso(),
        takeaways
      };

      const submitButton = event.submitter;
      if (submitButton) submitButton.disabled = true;

      try {
        const result = await postJSON(REFLECTION_TAKEAWAYS_ENDPOINT, payload);
        localStorage.setItem(KEYS.reflectionTakeaways, takeaways);
        setBool(KEYS.reflectionSubmitted);
        showSuccess($("reflection-form-status"), `Takeaways submitted. Step 3 is now available.${demoSuffix(result)}`);
        updateUI();
      } catch (error) {
        showWarning($("reflection-form-status"), "Your takeaways could not be submitted. Please try again.");
        if (submitButton) submitButton.disabled = false;
      }
    });

    // =========================================================
    // STEP 3: OBSERVATION + DEVELOPMENT GOAL
    // =========================================================

    $("request-observation").addEventListener("click", async () => {
      const btn = $("request-observation");
      btn.disabled = true;
      btn.textContent = "Sending Request...";

      try {
        const result = await postJSON(OBSERVATION_REQUEST_ENDPOINT, {
          coach_name: coachName(),
          request_type: "development_observation",
          requested_at: nowIso()
        });
        setBool(KEYS.observationRequested);
        showSuccess($("observation-request-status"), `Observation request recorded.${demoSuffix(result)}`);
        $("development-goal-card").classList.remove("hidden");
        btn.textContent = "Observation Requested";
        updateUI();
      } catch (error) {
        showWarning($("observation-request-status"), "The request could not be sent. Please try again.");
        btn.disabled = false;
        btn.textContent = "Request Observation";
      }
    });

    $("development-goal-form").addEventListener("submit", async (event) => {
      event.preventDefault();

      const payload = {
        coach_name: coachName(),
        submitted_at: nowIso(),
        strength_to_continue: $("goal-strength").value.trim(),
        area_to_improve: $("goal-area").value.trim(),
        why_this_area: $("goal-why").value.trim(),
        tangible_steps: $("goal-steps").value.trim()
      };

      if (!payload.strength_to_continue || !payload.area_to_improve || !payload.why_this_area || !payload.tangible_steps) return;

      const submitButton = event.submitter;
      if (submitButton) submitButton.disabled = true;

      try {
        const result = await postJSON(DEVELOPMENT_GOAL_ENDPOINT, payload);
        saveJSON(KEYS.developmentGoal, payload);
        setBool(KEYS.developmentGoalSubmitted);
        showSuccess($("development-goal-status"), `Development goal submitted. Step 4 is now available.${demoSuffix(result)}`);
        updateUI();
      } catch (error) {
        showWarning($("development-goal-status"), "Your development goal could not be submitted. Please try again.");
        if (submitButton) submitButton.disabled = false;
      }
    });

    // =========================================================
    // STEP 4: SEEK OUT SUPPORT
    // =========================================================

    $("support-form").addEventListener("submit", async (event) => {
      event.preventDefault();

      const payload = {
        coach_name: coachName(),
        submitted_at: nowIso(),
        support_person_and_role: $("support-person").value.trim(),
        additional_insights: $("support-insights").value.trim()
      };

      if (!payload.support_person_and_role || !payload.additional_insights) return;

      const submitButton = event.submitter;
      if (submitButton) submitButton.disabled = true;

      try {
        const result = await postJSON(SUPPORT_REFLECTION_ENDPOINT, payload);
        saveJSON(KEYS.supportReflection, payload);
        setBool(KEYS.supportSubmitted);
        showSuccess($("support-form-status"), `Support reflection submitted. Step 5 is now available.${demoSuffix(result)}`);
        updateUI();
      } catch (error) {
        showWarning($("support-form-status"), "Your support reflection could not be submitted. Please try again.");
        if (submitButton) submitButton.disabled = false;
      }
    });

    // =========================================================
    // STEP 5: RECORDING + SELF EVALUATION
    // =========================================================

    $("request-recording").addEventListener("click", async () => {
      const btn = $("request-recording");
      btn.disabled = true;
      btn.textContent = "Sending Request...";

      try {
        const result = await postJSON(RECORDING_REQUEST_ENDPOINT, {
          coach_name: coachName(),
          request_type: "self_evaluation_recording",
          requested_at: nowIso()
        });
        setBool(KEYS.recordingRequested);
        showSuccess($("recording-request-status"), `Recording request recorded.${demoSuffix(result)}`);
        $("self-eval-card").classList.remove("hidden");
        btn.textContent = "Recording Requested";
        updateUI();
      } catch (error) {
        showWarning($("recording-request-status"), "The request could not be sent. Please try again.");
        btn.disabled = false;
        btn.textContent = "Request Recording for Self-Evaluation";
      }
    });

    $("self-eval-form").addEventListener("submit", async (event) => {
      event.preventDefault();

      const payload = {
        coach_name: coachName(),
        submitted_at: nowIso(),
        original_development_goal: $("self-original-goal").value.trim(),
        one_percent_reflection: $("self-one-percent").value.trim()
      };

      if (!payload.original_development_goal || !payload.one_percent_reflection) return;

      const submitButton = event.submitter;
      if (submitButton) submitButton.disabled = true;

      try {
        const result = await postJSON(SELF_EVAL_ENDPOINT, payload);
        saveJSON(KEYS.selfEval, payload);
        setBool(KEYS.selfEvalSubmitted);
        showSuccess($("self-eval-status"), `Self-evaluation submitted. Step 6 is now available.${demoSuffix(result)}`);
        updateUI();
      } catch (error) {
        showWarning($("self-eval-status"), "Your self-evaluation could not be submitted. Please try again.");
        if (submitButton) submitButton.disabled = false;
      }
    });

    // =========================================================
    // STEP 6: FINAL OBSERVATION
    // =========================================================

    $("request-final-observation").addEventListener("click", async () => {
      const btn = $("request-final-observation");
      btn.disabled = true;
      btn.textContent = "Sending Request...";

      try {
        const result = await postJSON(FINAL_OBSERVATION_REQUEST_ENDPOINT, {
          coach_name: coachName(),
          request_type: "final_observation",
          requested_at: nowIso()
        });
        setBool(KEYS.finalObservationRequested);
        showSuccess($("final-observation-status"), `Final observation request recorded.${demoSuffix(result)}`);
        $("completion-box").classList.remove("hidden");
        btn.textContent = "Final Observation Requested";
        updateUI();
      } catch (error) {
        showWarning($("final-observation-status"), "The request could not be sent. Please try again.");
        btn.disabled = false;
        btn.textContent = "Request Final Observation";
      }
    });

    // =========================================================
    // RESTORE SAVED FORM CONTENT
    // =========================================================

    function restoreSavedContent() {
      $("reflection-takeaways").value = localStorage.getItem(KEYS.reflectionTakeaways) || "";

      const goal = loadJSON(KEYS.developmentGoal, {});
      $("goal-strength").value = goal.strength_to_continue || "";
      $("goal-area").value = goal.area_to_improve || "";
      $("goal-why").value = goal.why_this_area || "";
      $("goal-steps").value = goal.tangible_steps || "";

      const support = loadJSON(KEYS.supportReflection, {});
      $("support-person").value = support.support_person_and_role || "";
      $("support-insights").value = support.additional_insights || "";

      const selfEval = loadJSON(KEYS.selfEval, {});
      $("self-original-goal").value = selfEval.original_development_goal || goal.area_to_improve || "";
      $("self-one-percent").value = selfEval.one_percent_reflection || "";

      const goalPreview = goal.area_to_improve
        ? `<p><strong>Area of focus:</strong> ${escapeHTML(goal.area_to_improve)}</p><p><strong>Planned steps:</strong> ${escapeHTML(goal.tangible_steps || "")}</p>`
        : "Your saved goal will appear here after Step 3 is complete.";
      $("saved-goal-preview").innerHTML = goalPreview;
    }

    function escapeHTML(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    // =========================================================
    // UI / PROGRESS GATING
    // =========================================================

    function setStepState(step, state) {
      const card = $(`path-card-${step}`);
      const status = $(`path-status-${step}`);
      card.classList.remove("ready", "complete");

      if (state === "complete") {
        card.classList.add("complete");
        status.textContent = "Complete";
      } else if (state === "ready") {
        card.classList.add("ready");
        status.textContent = "Ready";
      } else {
        status.textContent = "Locked";
      }
    }

    function toggleStep(step, unlocked) {
      $(`step-${step}-locked`).classList.toggle("hidden", unlocked);
      $(`step-${step}-content`).classList.toggle("hidden", !unlocked);
    }

    function updateUI() {
      const started = Boolean(coachName());
      const readingDone = getBool(KEYS.readingComplete);
      const reflectionRequested = getBool(KEYS.reflectionRequested);
      const reflectionSubmitted = getBool(KEYS.reflectionSubmitted);
      const observationRequested = getBool(KEYS.observationRequested);
      const developmentGoalSubmitted = getBool(KEYS.developmentGoalSubmitted);
      const supportSubmitted = getBool(KEYS.supportSubmitted);
      const recordingRequested = getBool(KEYS.recordingRequested);
      const selfEvalSubmitted = getBool(KEYS.selfEvalSubmitted);
      const finalObservationRequested = getBool(KEYS.finalObservationRequested);

      toggleStep(1, started);
      toggleStep(2, readingDone);
      toggleStep(3, reflectionSubmitted);
      toggleStep(4, developmentGoalSubmitted);
      toggleStep(5, supportSubmitted);
      toggleStep(6, selfEvalSubmitted);

      setStepState(1, readingDone ? "complete" : started ? "ready" : "locked");
      setStepState(2, reflectionSubmitted ? "complete" : readingDone ? "ready" : "locked");
      setStepState(3, developmentGoalSubmitted ? "complete" : reflectionSubmitted ? "ready" : "locked");
      setStepState(4, supportSubmitted ? "complete" : developmentGoalSubmitted ? "ready" : "locked");
      setStepState(5, selfEvalSubmitted ? "complete" : supportSubmitted ? "ready" : "locked");
      setStepState(6, finalObservationRequested ? "complete" : selfEvalSubmitted ? "ready" : "locked");

      if (readingDone) {
        $("reading-complete-message").classList.remove("hidden");
        $("reading-complete-message").textContent = "Reading complete. Step 2 is now available.";
      }

      if (reflectionRequested) {
        $("request-reflection").disabled = true;
        $("request-reflection").textContent = "Reflection Meeting Requested";
        $("reflection-takeaway-card").classList.remove("hidden");
      }

      if (reflectionSubmitted) {
        showSuccess($("reflection-form-status"), "Takeaways submitted. Step 3 is available.");
      }

      if (observationRequested) {
        $("request-observation").disabled = true;
        $("request-observation").textContent = "Observation Requested";
        $("development-goal-card").classList.remove("hidden");
      }

      if (developmentGoalSubmitted) {
        showSuccess($("development-goal-status"), "Development goal submitted. Step 4 is available.");
      }

      if (supportSubmitted) {
        showSuccess($("support-form-status"), "Support reflection submitted. Step 5 is available.");
      }

      if (recordingRequested) {
        $("request-recording").disabled = true;
        $("request-recording").textContent = "Recording Requested";
        $("self-eval-card").classList.remove("hidden");
      }

      if (selfEvalSubmitted) {
        showSuccess($("self-eval-status"), "Self-evaluation submitted. Step 6 is available.");
      }

      if (finalObservationRequested) {
        $("request-final-observation").disabled = true;
        $("request-final-observation").textContent = "Final Observation Requested";
        $("completion-box").classList.remove("hidden");
      }

      restoreSavedContent();
      showSlide(currentSlide);
    }

    // =========================================================
    // RESET FOR TESTING
    // =========================================================

    $("reset-progress").addEventListener("click", () => {
      const confirmed = window.confirm("Reset all saved progress for this learning path on this browser?");
      if (!confirmed) return;

      Object.values(KEYS).forEach((key) => localStorage.removeItem(key));
      window.location.reload();
    });

    initializeStart();
    restoreSavedContent();
    showSlide(currentSlide);
    updateUI();
  </script>
</body>
</html>
