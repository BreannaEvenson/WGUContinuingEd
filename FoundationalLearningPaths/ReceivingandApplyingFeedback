    }

    .start-box label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    .name-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 12px;
    }

    input[type="text"],
    textarea,
    select {
      width: 100%;
      border: 2px solid #C9D5E3;
      border-radius: 12px;
      padding: 12px 14px;
      color: var(--navy-dark);
